<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PowerP.Realtime.MCP</RootNamespace>
    <AssemblyName>powerp-mcp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Distributed as a single self-contained binary: an integrator running this from
         an AI client should not have to install a runtime first. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PowerP.Realtime.API.Client/PowerP.Realtime.API.Client.csproj" />
  </ItemGroup>

</Project>
